# ==============================================================================
# ROOT / MAINTENANCE TOOLING ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# NOTE: This configuration file is exclusively for repository maintenance scripts
# (e.g., scripts/verify-academy-final.js, diff-live.js, migration-status.js).
# For the active Next.js 15 application deployed on Vercel, refer to client/.env.example.
# ==============================================================================

# MongoDB Atlas connection string (placeholder for maintenance scripts)
# Target database for production parity: academy_final
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/academy_final?retryWrites=true&w=majority

# JWT signing secret (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# Safety guard override (required for running scripts against academy_final)
ALLOW_PRODUCTION_DB=true

# Environment mode
NODE_ENV=development


