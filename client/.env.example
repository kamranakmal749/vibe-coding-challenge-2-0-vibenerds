# MongoDB Atlas connection string (placeholder)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# JWT signing secret (placeholder)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# Safety guard override: required in production to connect to non-dev/parity databases
ALLOW_PRODUCTION_DB=true

# Security Note: ALLOW_MOCK_NOW must NOT be set in production
# ALLOW_MOCK_NOW=false

