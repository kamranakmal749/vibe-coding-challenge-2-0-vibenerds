# MongoDB Atlas connection string (placeholder)
# NOTE: In production, MONGODB_URI must end in /academy_final (e.g. mongodb+srv://<user>:<password>@<cluster-host>/academy_final?retryWrites=true&w=majority)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/academy_final?retryWrites=true&w=majority

# JWT signing secret (placeholder - minimum 32 characters, no default value)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters

# Safety guard override: required in production (enforces connection exclusively to academy_final)
ALLOW_PRODUCTION_DB=true

# Security Note: ALLOW_MOCK_NOW must NOT be set in production
# ALLOW_MOCK_NOW=false

