{
  "name": "maidan-desk",
  "version": "1.0.0",
  "description": "Maidan Desk – sports academy management platform",
  "main": "legacy/server.js",
  "scripts": {
    "start": "node legacy/server.js",
    "dev": "node --watch --watch-path=legacy/src --watch-path=legacy/server.js legacy/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test legacy/test/acceptance.test.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:start": "npm --prefix client run start"
  },
  "keywords": [
    "sports",
    "academy",
    "attendance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "puppeteer-core": "^25.16.0"
  }
}
